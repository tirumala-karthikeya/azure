# Copy this file to .env and fill in real values. .env is gitignored.

# Azure OpenAI (Foundry / Cognitive Services)
# Endpoint: from Azure Portal -> your AIServices resource -> Keys and Endpoint.
# Use the *.cognitiveservices.azure.com host (NOT *.services.ai.azure.com — that's the Agents Service).
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Jira (required only when wiring the planner output to a real Jira instance).
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
JIRA_ISSUE_TYPE=Story
